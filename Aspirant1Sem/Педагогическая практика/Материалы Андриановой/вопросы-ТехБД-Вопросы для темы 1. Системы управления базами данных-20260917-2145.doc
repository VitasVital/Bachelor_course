<tr>
<td colspan="3" style="width: 12.0cm"><p class="TableRowHead" style="text-align: right">&#1048;&#1076;&#1077;&#1085;&#1090;&#1080;&#1092;&#1080;&#1082;&#1072;&#1094;&#1080;&#1086;&#1085;&#1085;&#1099;&#1081; &#1085;&#1086;&#1084;&#1077;&#1088;:</p></td>
