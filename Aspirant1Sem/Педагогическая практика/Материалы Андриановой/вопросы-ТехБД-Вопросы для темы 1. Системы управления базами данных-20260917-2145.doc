<tr>
<td colspan="3" style="width: 12.0cm"><p class="TableRowHead" style="text-align: right">&#1053;&#1091;&#1084;&#1077;&#1088;&#1086;&#1074;&#1072;&#1090;&#1100; &#1074;&#1072;&#1088;&#1080;&#1072;&#1085;&#1090;&#1099; &#1086;&#1090;&#1074;&#1077;&#1090;&#1086;&#1074;?</p></td>
<td style="width: 1.0cm"><p class="Cell">a</p></td></tr>
<tr>
<td colspan="3" style="width: 12.0cm"><p class="TableRowHead" style="text-align: right">&#1055;&#1086;&#1082;&#1072;&#1079;&#1072;&#1090;&#1100; &#1082;&#1086;&#1083;&#1080;&#1095;&#1077;&#1089;&#1090;&#1074;&#1086; &#1087;&#1088;&#1072;&#1074;&#1080;&#1083;&#1100;&#1085;&#1099;&#1093; &#1086;&#1090;&#1074;&#1077;&#1090;&#1086;&#1074; &#1087;&#1086;&#1089;&#1083;&#1077; &#1086;&#1082;&#1086;&#1085;&#1095;&#1072;&#1085;&#1080;&#1103;:</p></td>
